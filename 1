<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TAPHONE - Máy Ảo Cloud</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; user-select: none; }
    body { background-color: #090a0f; color: #fff; display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 20px 10px; }
    .btn-init { background: linear-gradient(135deg, #5865F2, #404EED); color: #fff; border: none; padding: 12px 24px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(88,101,242,0.4); }
    .phone-container { width: 360px; height: 740px; background: #111214; border-radius: 40px; border: 8px solid #2b2d31; position: relative; overflow: hidden; display: flex; flex-direction: column; }
    .status-bar { height: 30px; background: #000; display: flex; justify-content: space-between; align-items: center; padding: 0 20px; font-size: 12px; }
    .screen { flex: 1; position: relative; background: #1e1f22; display: flex; flex-direction: column; }
    .loader-screen { position: absolute; inset: 0; background: #0b0e14; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 99; }
    .spinner { width: 45px; height: 45px; border: 4px solid #2b2d31; border-top-color: #5865F2; border-radius: 50%; animation: spin 1s infinite linear; margin-bottom: 15px; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .desktop-screen { padding: 30px 20px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .app-icon { display: flex; flex-direction: column; align-items: center; cursor: pointer; }
    .app-img { width: 60px; height: 60px; border-radius: 16px; display: flex; justify-content: center; align-items: center; font-size: 28px; margin-bottom: 8px; }
    .taphone-icon { background: linear-gradient(135deg, #10b981, #059669); }
    .discord-icon { background: #5865F2; }
    .app-window { position: absolute; inset: 0; background: #2b2d31; z-index: 20; display: flex; flex-direction: column; }
    .discord-header { background: #1e1f22; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; font-weight: bold; }
    .channel-list { flex: 1; overflow-y: auto; padding: 10px 8px; }
    .category { font-size: 11px; font-weight: 700; color: #949ba4; text-transform: uppercase; padding: 12px 8px 4px; }
    .channel-item { display: flex; align-items: center; padding: 8px 10px; border-radius: 6px; color: #949ba4; cursor: pointer; font-size: 15px; }
    .chat-view { position: absolute; inset: 0; background: #313338; z-index: 30; display: flex; flex-direction: column; }
    .chat-header { height: 48px; background: #313338; border-bottom: 1px solid #232428; display: flex; align-items: center; padding: 0 16px; font-weight: bold; gap: 10px; }
    .messages-area { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
    .message-box { background: #2b2d31; border-radius: 8px; padding: 12px; font-size: 13px; line-height: 1.5; white-space: pre-wrap; }
    .chat-input-container { padding: 10px 16px; background: #313338; position: relative; }
    .chat-input { width: 100%; background: #383a40; border: none; border-radius: 8px; padding: 10px 14px; color: #fff; font-size: 14px; outline: none; }
    .slash-popup { position: absolute; bottom: 50px; left: 16px; right: 16px; background: #2b2d31; border-radius: 8px; border: 1px solid #1e1f22; display: none; flex-direction: column; max-height: 180px; overflow-y: auto; }
    .slash-item { padding: 8px 12px; cursor: pointer; font-size: 13px; display: flex; gap: 8px; align-items: center; }
    .copy-btn { margin-top: 6px; background: #5865F2; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold; }
    .hidden { display: none !important; }
  </style>
</head>
<body>

  <button class="btn-init" onclick="initVM()">Khởi Tạo Máy Ảo (5s)</button>

  <div class="phone-container">
    <div class="status-bar"><span>09:41</span><span>📶 5G 🔋 100%</span></div>
    <div class="screen">
      <div id="loader" class="loader-screen hidden">
        <div class="spinner"></div>
        <p id="loader-text">Đang khởi tạo máy ảo (5s)...</p>
      </div>

      <div id="desktop" class="desktop-screen hidden">
        <div class="app-icon" onclick="openApp('taphone')">
          <div class="app-img taphone-icon">📱</div>
          <span style="font-size:12px">TAPHONE</span>
        </div>
        <div class="app-icon" onclick="openApp('discord')">
          <div class="app-img discord-icon">💬</div>
          <span style="font-size:12px">Discord</span>
        </div>
      </div>

      <div id="discord-app" class="app-window hidden">
        <div class="discord-header">
          <div>TAPHONE ›</div>
          <div style="cursor:pointer" onclick="closeApp()">✖</div>
        </div>
        <div class="channel-list">
          <div class="category">welcome | goodbye</div>
          <div class="channel-item" onclick="openChannel('welcome')"># welcome</div>
          <div class="channel-item" onclick="openChannel('goodbye')"># goodbye</div>
          <div class="category">rules</div>
          <div class="channel-item" onclick="openChannel('rules')"># rules</div>
          <div class="category">notification</div>
          <div class="channel-item" onclick="openChannel('notification')"># notification</div>
          <div class="category">tutorial</div>
          <div class="channel-item" onclick="openChannel('tutorial')"># tutorial</div>
          <div class="category">bot</div>
          <div class="channel-item" onclick="openChannel('taphone-bot')"># taphone-bot</div>
          <div class="channel-item" onclick="openChannel('code-redeem')"># code-redeem</div>
          <div class="channel-item" onclick="openChannel('buy-cloud')"># buy-cloud</div>
          <div class="channel-item" onclick="openChannel('buff-thoi-gian')"># buff-thoi-gian</div>
        </div>
      </div>

      <div id="chat-view" class="chat-view hidden">
        <div class="chat-header">
          <span style="cursor:pointer" onclick="closeChat()">❮</span>
          <span id="chat-title"># rules</span>
        </div>
        <div class="messages-area" id="messages-area"></div>
        <div class="chat-input-container">
          <div class="slash-popup" id="slash-popup">
            <div class="slash-item" onclick="selectCmd('/getlink')"><b style="color:#5865F2">/getlink</b> Lấy link 80s</div>
            <div class="slash-item" onclick="selectCmd('/checklink')"><b style="color:#5865F2">/checklink</b> Check link</div>
            <div class="slash-item" onclick="selectCmd('/coderedeem')"><b style="color:#5865F2">/coderedeem</b> Lấy code</div>
            <div class="slash-item" onclick="selectCmd('/taotaikhoan ')"><b style="color:#5865F2">/taotaikhoan</b> Tạo tài khoản</div>
            <div class="slash-item" onclick="selectCmd('/buycloud ')"><b style="color:#5865F2">/buycloud</b> Mua máy</div>
            <div class="slash-item" onclick="selectCmd('/buff ')"><b style="color:#5865F2">/buff</b> Buff thời gian</div>
          </div>
          <input type="text" id="chat-input" class="chat-input" placeholder="Nhập tin nhắn hoặc gõ /..." oninput="handleInput()" onkeydown="handleKeyDown(event)">
        </div>
      </div>
    </div>
  </div>

  <script>
    let hasCompletedLink = false;
    let hasCheckedLink = false;
    let activeCode = null;

    function initVM() {
      const loader = document.getElementById('loader');
      const desktop = document.getElementById('desktop');
      loader.classList.remove('hidden');
      desktop.classList.add('hidden');
      closeApp();
      setTimeout(() => {
        loader.classList.add('hidden');
        desktop.classList.remove('hidden');
      }, 5000);
    }

    function openApp(app) {
      if (app === 'discord') document.getElementById('discord-app').classList.remove('hidden');
      else alert("Ứng dụng TAPHONE chạy giao diện VSPhone.");
    }
    function closeApp() { document.getElementById('discord-app').classList.add('hidden'); closeChat(); }
    function closeChat() { document.getElementById('chat-view').classList.add('hidden'); }

    function openChannel(name) {
      document.getElementById('chat-title').innerText = '# ' + name;
      document.getElementById('chat-view').classList.remove('hidden');
      const msgArea = document.getElementById('messages-area');
      msgArea.innerHTML = '';
      if (name === 'rules') addMsg("Luật server\nNỘI QUY SERVER TAPHONE\n\n[1] TÔN TRỌNG\n- Không toxic, xúc phạm hoặc công kích.\n[2] BÁO CÁO\n- Không report sai sự thật.\n[3] SPAM\n- Không spam tin nhắn.");
      else if (name === 'notification') addMsg("Admin đã update cách lấy máy mới, vui lòng vô kênh tutorial xem chi tiết.");
      else if (name === 'tutorial') addMsg("CÁCH LẤY MÁY 1 DAY MỚI:\n1. Dùng /getlink rồi đợi 80s\n2. Dùng /checklink\n3. Dùng /coderedeem lấy code\n4. Dùng /taotaikhoan [code]\n5. Dùng /buycloud [code] [gmail] [pass]");
    }

    function addMsg(text, isBot = false) {
      const msgArea = document.getElementById('messages-area');
      const box = document.createElement('div');
      box.className = 'message-box';
      if (isBot) box.style.borderLeft = "4px solid #5865F2";
      box.innerText = text;
      msgArea.appendChild(box);
      msgArea.scrollTop = msgArea.scrollHeight;
    }

    function handleInput() {
      const val = document.getElementById('chat-input').value;
      document.getElementById('slash-popup').style.display = val.startsWith('/') ? 'flex' : 'none';
    }

    function selectCmd(cmd) {
      document.getElementById('chat-input').value = cmd;
      document.getElementById('slash-popup').style.display = 'none';
    }

    function handleKeyDown(e) {
      if (e.key === 'Enter') {
        const val = document.getElementById('chat-input').value.trim();
        if (val.startsWith('/')) executeCmd(val);
        else if (val) addMsg("Bạn: " + val);
        document.getElementById('chat-input').value = '';
        document.getElementById('slash-popup').style.display = 'none';
      }
    }

    function executeCmd(fullCmd) {
      addMsg("Bạn: " + fullCmd);
      const parts = fullCmd.split(" ");
      const cmd = parts[0];

      if (cmd === '/getlink') {
        let seconds = 80;
        addMsg("TAPHONE BOT: Vui lòng vô link và chờ 80 giây...\nhttps://taphone.com/get-link-80s", true);
        const interval = setInterval(() => {
          seconds -= 20;
          if (seconds <= 0) {
            clearInterval(interval);
            hasCompletedLink = true;
            addMsg("TAPHONE BOT: 🎉 Đã đủ 80 giây! Bạn đã vượt link thành công. Dùng /checklink nhé.", true);
          }
        }, 1000);
        return;
      }

      if (!hasCompletedLink) {
        addMsg("TAPHONE BOT: ❌ Lỗi! Bạn chưa vượt link 80s. Hãy dùng lệnh /getlink trước!", true);
        return;
      }

      if (cmd === '/checklink') {
        addMsg("TAPHONE BOT: Đang kiểm tra link...", true);
        setTimeout(() => {
          hasCheckedLink = true;
          addMsg("TAPHONE BOT: ✅ Đã check link thành công! Hãy dùng lệnh /coderedeem để lấy Code nhé.", true);
        }, 2000);
        return;
      }

      if (!hasCheckedLink) {
        addMsg("TAPHONE BOT: ❌ Lỗi! Bạn chưa dùng lệnh /checklink để xác minh link!", true);
        return;
      }

      if (cmd === '/coderedeem') {
        addMsg("TAPHONE BOT: Đang tạo code redeem...", true);
        setTimeout(() => {
          activeCode = "TAPHONE-" + Math.floor(100000 + Math.random() * 900000);
          const msgArea = document.getElementById('messages-area');
          const box = document.createElement('div');
          box.className = 'message-box';
          box.style.borderLeft = "4px solid #5865F2";
          box.innerHTML = `<strong>TAPHONE BOT:</strong><br>Code Redeem: <b style="color:#10b981">${activeCode}</b><br><button class="copy-btn" onclick="copyText('${activeCode}', this)">Copy Nhanh</button><br><small style="color:#949ba4">🔒 Chỉ có 1 mình bạn thấy tin nhắn này.<br>⚠️ Chỉ có 1 người nhập được code này.</small>`;
          msgArea.appendChild(box);
          msgArea.scrollTop = msgArea.scrollHeight;
        }, 1500);
        return;
      }

      const inputCode = parts[1];
      if (!inputCode || inputCode !== activeCode) {
        addMsg("TAPHONE BOT: ❌ Lỗi! Bạn cần nhập Code Redeem hợp lệ. Ví dụ: " + cmd + " " + (activeCode || "TAPHONE-123456"), true);
        return;
      }

      if (cmd === '/taotaikhoan') {
        addMsg("TAPHONE BOT: Đang tạo tài khoản cho bạn (vui lòng chờ 10s)...", true);
        setTimeout(() => {
          const rand = Math.floor(10000 + Math.random() * 90000);
          const email = `taphone${rand}@taphone.com`;
          const pass = `Taphone@${rand}`;
          const msgArea = document.getElementById('messages-area');
          const box = document.createElement('div');
          box.className = 'message-box';
          box.style.borderLeft = "4px solid #5865F2";
          box.innerHTML = `<strong>TAPHONE BOT:</strong><br>🎉 Tạo tài khoản thành công!<br>Gmail: <b>${email}</b> <button class="copy-btn" onclick="copyText('${email}', this)">Copy Gmail</button><br>Pass: <b>${pass}</b> <button class="copy-btn" onclick="copyText('${pass}', this)">Copy Pass</button>`;
          msgArea.appendChild(box);
          msgArea.scrollTop = msgArea.scrollHeight;
        }, 3000);
      } else if (cmd === '/buycloud') {
        const gmail = parts[2];
        const pass = parts[3];
        if (!gmail || !pass) {
          addMsg("TAPHONE BOT: ❌ Thiếu thông tin! Cú pháp chuẩn: /buycloud [Code] [Gmail] [Pass]", true);
          return;
        }
        addMsg("TAPHONE BOT: Đang kích hoạt mua máy ảo...", true);
        setTimeout(() => {
          addMsg(`TAPHONE BOT: 🎉 Mua máy Cloud thành công cho ${gmail}!`, true);
        }, 2000);
      } else if (cmd === '/buff') {
        addMsg("TAPHONE BOT: 🎉 Buff thời gian thành công +2 ngày cho máy ảo!", true);
      }
    }

    function copyText(text, btn) {
      navigator.clipboard.writeText(text);
      btn.innerText = "Đã Copy!";
      setTimeout(() => btn.innerText = "Copy Nhanh", 2000);
    }
  </script>
</body>
</html>
